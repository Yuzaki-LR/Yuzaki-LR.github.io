---
import { getCollection } from 'astro:content';
import ManuscriptEntry from '../components/ManuscriptEntry.astro';
import ProjectListItem from '../components/ProjectListItem.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { loadSiteRepository } from '../lib/content/repository.mjs';
import { toPublicSiteModel } from '../lib/content/render-model.mjs';

const projects = (await getCollection('projects'))
  .filter((project) => project.data.featured)
  .sort((a, b) => a.data.order - b.data.order);
const site = toPublicSiteModel(await loadSiteRepository(), { base: import.meta.env.BASE_URL });
const manuscripts = site.research;
---

<BaseLayout
  title="Yunxi Wu | Electronic and Electrical Engineering"
  description="Academic profile of Yunxi Wu, a BEng Electronic and Electrical Engineering student at the University of Birmingham."
  site={site}
  activeNav="About"
>
  <h1>About</h1>
  <p class="lead">{site.profile.intro}</p>

  <section>
    <h2>Selected Projects</h2>
    <div class="project-list">
      {projects.map((project) => <ProjectListItem project={project} headingLevel="h3" base={site.base} />)}
    </div>
  </section>

  <section>
    <h2>Research &amp; Manuscripts</h2>
    {manuscripts.map((entry: { title: string; status?: string; authorship?: string; summary: string; scope?: string[] }) => <ManuscriptEntry entry={entry} />)}
  </section>

  <div class="notice">
    <strong>Current direction</strong>
    <p>{site.about.currentDirection}</p>
  </div>
</BaseLayout>
