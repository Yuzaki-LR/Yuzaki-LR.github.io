---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProjectDocument from '../../components/ProjectDocument.astro';
import { loadSiteRepository } from '../../lib/content/repository.mjs';
import { toPublicSiteModel } from '../../lib/content/render-model.mjs';

export async function getStaticPaths() {
  const repository = await loadSiteRepository();
  return repository.projects.map(({ document }) => ({ params: { id: document.slug }, props: { project: document } }));
}

interface Props {
  project: {
    slug: string;
    frontmatter: { category: string; title: string; shortTitle: string; summary: string; role: string; methods: string[] };
    sections: Array<{ kind: 'standard' | 'contribution'; hidden: boolean; title: string; blocks: Array<{ id: string; type: string; hidden: boolean; markdown?: string; raw?: string }> }>;
  };
}
const { project } = Astro.props;
const repository = await loadSiteRepository();
const site = toPublicSiteModel(repository, { base: import.meta.env.BASE_URL });
---

<BaseLayout title={`${project.frontmatter.shortTitle} | Yunxi Wu`} description={project.frontmatter.summary} site={site} activeNav="Projects">
  <ProjectDocument project={project} base={import.meta.env.BASE_URL} />
</BaseLayout>
