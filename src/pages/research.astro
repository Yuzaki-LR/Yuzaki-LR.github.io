---
import ManuscriptEntry from '../components/ManuscriptEntry.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { loadSiteRepository } from '../lib/content/repository.mjs';
import { toPublicSiteModel } from '../lib/content/render-model.mjs';

const site = toPublicSiteModel(await loadSiteRepository(), { base: import.meta.env.BASE_URL });
const manuscripts = site.research;
---

<BaseLayout
  title="Research | Yunxi Wu"
  description="Research interests, ongoing direction, and submitted manuscript by Yunxi Wu."
  site={site}
  activeNav="Research"
>
  <h1>Research</h1>

  <section>
    <h2>Research Interests</h2>
    <ul class="interest-list">
      {site.profile.interests.map((interest: string) => <li>{interest}</li>)}
    </ul>
  </section>

  <section>
    <h2>Ongoing Work</h2>
    <p>{site.about.currentDirection}</p>
  </section>

  <section>
    <h2>Research &amp; Manuscripts</h2>
    {manuscripts.map((entry: { title: string; status?: string; authorship?: string; summary: string; scope?: string[] }) => <ManuscriptEntry entry={entry} />)}
  </section>
</BaseLayout>
