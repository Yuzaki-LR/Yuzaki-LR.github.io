---
interface Props {
  site: { base: string; profile: { name: string }; navigation: { label: string; href: string }[] };
  active?: 'About' | 'Projects' | 'Research';
}

const { site, active } = Astro.props;
---

<nav class="site-nav" aria-label="Primary">
  <a class="site-name" href={site.base}>{site.profile.name}</a>
  <ul>
    {site.navigation.map((item) => (
      <li>
        <a href={item.href} aria-current={active === item.label ? 'page' : undefined}>
          {item.label}
        </a>
      </li>
    ))}
  </ul>
</nav>
