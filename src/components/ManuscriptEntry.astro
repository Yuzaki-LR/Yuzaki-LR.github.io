---
interface Props {
  entry: { title: string; status?: string; authorship?: string; summary: string; scope?: string[] };
}

const { entry } = Astro.props;
---

<article class="manuscript-entry">
  {entry.status && <p class="manuscript-status">{entry.status}</p>}
  <h3>{entry.title}</h3>
  <p>{entry.authorship && <strong>{entry.authorship}.</strong>} {entry.summary}</p>
  {entry.scope?.length && <ul>{entry.scope.map((item) => <li>{item}</li>)}</ul>}
</article>
