---
const { project, headingLevel, base = '/' } = Astro.props;
const Heading = headingLevel;
const data = project.frontmatter;
---

<article class="project-row">
  <div>
    <Heading><a href={`${base}projects/${project.slug}/`}>{data.title}</a></Heading>
    <p>{data.summary}</p>
  </div>
  <dl class="project-meta">
    <div><dt>Type</dt><dd>{data.category}</dd></div>
    <div><dt>Role</dt><dd>{data.role}</dd></div>
  </dl>
</article>
