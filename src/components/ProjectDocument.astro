---
import ContentBlocks from './ContentBlocks.astro';

interface Block { id: string; type: string; hidden: boolean; markdown?: string; raw?: string }
interface Section { kind: 'standard' | 'contribution'; hidden: boolean; title: string; blocks: Block[] }
interface Project { slug: string; frontmatter: { category: string; title: string; summary: string; role: string; methods: string[] }; sections: Section[] }
interface Props { project: Project; base?: string }
const { project, base = '/' } = Astro.props;
const data = project.frontmatter;
const sections = project.sections.filter((section) => !section.hidden && section.blocks.some((block) => !block.hidden));
---

<p class="eyebrow">{data.category}</p>
<h1>{data.title}</h1>
<p class="lead">{data.summary}</p>
<dl class="project-summary">
  <div><dt>Role</dt><dd>{data.role}</dd></div>
  <div><dt>Methods and tools</dt><dd>{data.methods.join(' · ')}</dd></div>
</dl>
{sections.map((section) => (
  <section class:list={['project-section', { 'contribution-section': section.kind === 'contribution' }]}>
    <h2>{section.title}</h2>
    <ContentBlocks blocks={section.blocks} projectSlug={project.slug} base={base} />
  </section>
))}
