---
import type { CollectionEntry } from 'astro:content';
import { internalHref } from '../lib/content/render-model.mjs';

interface Props {
  evidence: CollectionEntry<'projects'>['data']['evidence'];
  base: string;
}

const { evidence, base } = Astro.props;
---

<div class="evidence-grid">
  {evidence.map((item) => (
    <figure>
      <img src={internalHref(base, item.src)} alt={item.alt} loading="lazy" decoding="async" />
      <figcaption>{item.caption}</figcaption>
    </figure>
  ))}
</div>
